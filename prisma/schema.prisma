generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Family {
  id        String   @id @default(cuid())
  name      String
  parentId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  kids          Kid[]
  chores        Chore[]
  rewards       Reward[]
  habits        Habit[]
  familyGoals   FamilyGoal[]
  badges        BadgeDefinition[]
  invites       FamilyInvite[]
  members       FamilyMember[]
}

model FamilyMember {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // OWNER, MEMBER
  createdAt DateTime @default(now())
  
  @@unique([familyId, parentId])
  @@index([parentId])
}

model Parent {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  password       String
  recoveryCodes  String?  // JSON array of hashed single-use recovery codes
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  notifications Notification[]
  subscriptions PushSubscription[]
  invites       FamilyInvite[]
  familyMemberships FamilyMember[]
}

// Note: the original schema had a single `streakDays` field (INTEGER, NOT NULL).
// Migration 20260722000000_add_gamification_streak_fields split this into
// `currentStreak` + `longestStreak` (both default 0) + added `lastCompletedAt`
// (DateTime?). The split was needed because the gamification engine
// (src/lib/gamification.ts) tracks "longest streak ever" separately from
// the current count, and `streakDays` couldn't represent that.

model Kid {
  id             String   @id @default(cuid())
  name           String
  age            Int
  avatarId       String   @default("default")
  familyId       String
  family         Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  points         Int      @default(0)
  totalPoints    Int      @default(0)
  gems           Int      @default(0)
  totalGems      Int      @default(0)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  level          Int      @default(1)
  experience     Int      @default(0)
  lastActiveAt   DateTime?
  lastCompletedAt DateTime?
  themeMode      String   @default("NEUTRAL")
  primaryColor   String   @default("#6366f1")
  secondaryColor String   @default("#8b5cf6")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  choreAssignments ChoreAssignment[]
  habitLogs       HabitLog[]
  redemptions     Redemption[]
  earnedBadges    EarnedBadge[]

  @@index([familyId])
}

model Chore {
  id          String      @id @default(cuid())
  title       String
  description String?
  basePoints  Int         @default(5)
  icon        String?     @default("📋")
  difficulty  String      @default("EASY")
  recurring   String?
  timeOfDay   String      @default("ANYTIME")
  isActive    Boolean     @default(true)
  familyId    String
  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  assignments ChoreAssignment[]

  @@index([familyId])
}

model ChoreAssignment {
  id          String    @id @default(cuid())
  choreId     String
  chore       Chore     @relation(fields: [choreId], references: [id], onDelete: Cascade)
  kidId       String
  kid         Kid       @relation(fields: [kidId], references: [id], onDelete: Cascade)
  dueDate     DateTime
  status      String    @default("PENDING")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([kidId, dueDate])
  @@index([status])
  @@unique([choreId, kidId, dueDate])
}

model Reward {
  id          String   @id @default(cuid())
  title       String
  description String?
  cost        Int
  icon        String?
  category    String?
  isActive    Boolean  @default(true)
  familyId    String
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  redemptions Redemption[]

  @@index([familyId])
}

model Redemption {
  id        String   @id @default(cuid())
  rewardId  String
  reward    Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  kidId     String
  kid       Kid      @relation(fields: [kidId], references: [id], onDelete: Cascade)
  points    Int
  createdAt DateTime @default(now())
}

model Habit {
  id          String   @id @default(cuid())
  title       String
  description String?
  icon        String?
  points      Int      @default(5)
  isActive    Boolean  @default(true)
  familyId    String
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  logs        HabitLog[]

  @@index([familyId])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  kidId     String
  kid       Kid      @relation(fields: [kidId], references: [id], onDelete: Cascade)
  loggedAt  DateTime @default(now())
  
  @@index([kidId, loggedAt])
}

model FamilyGoal {
  id           String   @id @default(cuid())
  title        String
  description  String?
  targetPoints Int
  currentPoints Int    @default(0)
  reward       String?
  isActive     Boolean  @default(true)
  familyId     String
  family       Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([familyId])
}

model BadgeDefinition {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String
  requirement String
  familyId    String?
  family      Family?  @relation(fields: [familyId], references: [id])
  createdAt   DateTime @default(now())
  
  earned      EarnedBadge[]
}

model EarnedBadge {
  id        String   @id @default(cuid())
  badgeId   String
  badge     BadgeDefinition @relation(fields: [badgeId], references: [id])
  kidId     String
  kid       Kid      @relation(fields: [kidId], references: [id])
  earnedAt  DateTime @default(now())
  
  @@unique([badgeId, kidId])
}

model FamilyInvite {
  id          String    @id @default(cuid())
  email       String
  familyId    String
  family      Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  role        String    @default("MEMBER")
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  createdById String?
  createdBy   Parent?   @relation(fields: [createdById], references: [id])

  @@index([email])
  @@index([token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([token])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      Parent    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  icon      String?
  data      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model PushSubscription {
  id        String    @id @default(cuid())
  userId    String
  user      Parent    @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  keys      String
  createdAt DateTime  @default(now())
  updatedAt DateTime?

  @@unique([userId, endpoint])
}

// NOTE: AvatarItem and RedeemedReward still exist as tables in the database
// (created by 0001_init, never dropped by a migration). They were removed
// from this schema in #179 without a migration, which would make the next
// `prisma migrate dev` generate DROP TABLE statements for them. Restored
// here to keep the schema in sync with the migration history. If these
// models are truly dead, drop them via a proper migration PR instead.
model AvatarItem {
  id          String   @id @default(cuid())
  name        String
  emoji       String
  category    String
  unlockCost  Int
  imageUrl    String
  createdAt   DateTime @default(now())
}

model RedeemedReward {
  id        String   @id @default(cuid())
  rewardId  String
  kidId     String
  points    Int
  createdAt DateTime @default(now())
}

model PlannerItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  kidId       String?
  createdAt   DateTime @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  email     String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([email, createdAt])
}

model RecoveryCode {
  id        String   @id @default(cuid())
  parentId  String
  codeHash  String   // bcrypt hash of the single-use code
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([parentId])
  @@index([codeHash])
}

// Persistent rate-limit counter. Replaces the in-memory Map that previously
// reset on every container restart, which let an attacker bypass limits by
// waiting for deploys. Each (identifier, action) pair keeps a rolling
// window; a cleanup query prunes expired rows.
model RateLimit {
  id         String   @id @default(cuid())
  identifier String   // IP, email, user id, etc.
  action     String   // 'login', 'register', 'forgot-password', etc.
  count      Int      @default(1)
  resetAt    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, action])
  @@index([resetAt])
}
