# Database (local development)
DATABASE_URL=postgresql://chorechamps:localdev@localhost:5432/chorechamps
POSTGRES_USER=chorechamps
POSTGRES_PASSWORD=localdev
POSTGRES_DB=chorechamps

# NextAuth
NEXTAUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# Push Notifications (optional — required for web push)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# PostHog (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ────────────────────────────────────────────────
# Production Deployment (Coolify / Docker)
# ────────────────────────────────────────────────
#
# For docker-compose.prod.yml, create a .env.production file with:
#
#   DATABASE_URL=postgresql://<user>:<password>@kids-chore-postgres:5432/chorechamps
#   POSTGRES_USER=<user>
#   POSTGRES_PASSWORD=<strong-random-password>
#   POSTGRES_DB=chorechamps
#   NEXTAUTH_SECRET=<strong-random-secret-min-32-chars>
#   NEXTAUTH_URL=https://chores.ashbi.ca
#
# ⚠️ NEVER commit .env.production or any file containing real secrets to git.
#    Rotate secrets immediately if they have ever been committed.
