{
  "name": "kids-chore-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "npx tsx --test src/lib/utils.test.ts src/lib/gamification.test.ts src/lib/manifest.test.ts",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate || true",
    "prepare": "git config core.hooksPath .husky || true",
    "seed": "node prisma/seed.js",
    "smoke:production": "node scripts/production-smoke.cjs",
    "store:validate": "node scripts/validate-store-assets.cjs",
    "db:migrate": "npm run db:push",
    "db:push": "prisma db push"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "framer-motion": "^12.43.0",
    "geist": "^1.7.2",
    "i18next": "^26.4.2",
    "lucide-react": "^0.577.0",
    "next": "^16.3.4",
    "next-auth": "^4.24.15",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "playwright": "^1.60.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "nanoid": "^3.3.17",
    "fast-uri": "^3.1.5",
    "tar": "7.5.22",
