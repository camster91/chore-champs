#!/usr/bin/env sh
# .husky/commit-msg — enforce Conventional Commits format.
#
# Optional but recommended: catches typos in commit-message prefixes before
# they end up in `git log --oneline`. Lightweight — only checks the subject
# line, doesn't reformat.
#
# Format: <type>(<scope>): <subject>
#   type:    feat | fix | chore | docs | refactor | test | perf | build | ci
#   scope:   optional, in parens
#   subject: imperative mood, lowercase, no period
#
# Examples that pass:
#   feat(dashboard): add streak widget
#   fix: handle missing migration
#   chore(deps): bump next from 16.2.10 to 16.2.11
#
# Examples that fail:
#   "Add streak widget"            (no type prefix)
#   "feat: add."                  (period in subject)
#   "FEAT: add streak widget"     (uppercase type)
#
# Skipped with `git commit --no-verify` or `git commit -m` with no editor.

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# Extract the first line (subject).
subject=$(printf '%s\n' "$commit_msg" | head -n 1)

# Allow merge commits and revert commits through untouched.
case "$subject" in
  "Merge "*|"Revert "*|"" ) exit 0 ;;
esac

# Match Conventional Commits prefix.
if printf '%s' "$subject" | grep -qE '^(feat|fix|chore|docs|refactor|test|perf|build|ci)(\([a-z0-9_-]+\))?!?: '; then
  exit 0
fi

echo ""
echo "[husky] commit-msg: subject does not match Conventional Commits format."
echo "[husky] got:      $subject"
echo ""
echo "[husky] expected: <type>(<scope>)?: <subject>"
echo "[huskey] types:    feat | fix | chore | docs | refactor | test | perf | build | ci"
echo ""
echo "[husky] bypass:   git commit --no-verify (only if you know what you're doing)"
exit 1